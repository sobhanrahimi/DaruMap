# ==========================================
# DaruMap (دارومپ) — Staging Environment Variables
# ==========================================

# 1. Database Connection (PostgreSQL - Mandatory)
DATABASE_URL="postgresql://user:password@localhost:5432/daroomap?schema=public"

# 2. Application Environment (Mandatory)
NODE_ENV="staging"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Authentication Secrets (Mandatory)
NEXTAUTH_SECRET="your-staging-nextauth-secret-key-change-this"
NEXTAUTH_URL="http://localhost:3000"

# 4. Storage Configuration for Prescriptions (Mandatory)
PRESCRIPTION_STORAGE_PATH="./uploads/prescriptions"

# 5. Background Reminder Worker Secret Key (Mandatory for Cron)
CRON_SECRET_KEY="your-staging-cron-secret-key"
